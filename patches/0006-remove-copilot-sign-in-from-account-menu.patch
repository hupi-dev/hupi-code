+// HUPI Code patch: this command's only effect was opening Copilot's own
+// sign-in flow (CHAT_SETUP_ACTION_ID) — already made a silent no-op by
+// patches/0004 (ChatSetupContribution, which registers that command, is
+// skipped outright), but the "Sign in to use GitHub Copilot" menu entry
+// itself was still unconditionally registered here regardless, visible
+// in the Account Menu (the person icon) whenever signed out — a worse
+// outcome than just not being there (a named, branded sign-in button
+// that silently does nothing when clicked). Same reasoning as
+// 0002/0003/0004/0005: a HUPI-native IDE shouldn't surface a sign-in
+// affordance for a competing, unbundled chat.
+if (!product.hupiDisableCopilotAccountSignIn) {
+	// Sign In (shown when signed out)
+	registerAction2(class extends Action2 {
+		constructor() {
+			super({
+				id: AGENTIC_SIGN_IN_COMMAND_ID,
+				title: localize2('signIn', "Sign in to use GitHub Copilot"),
+				icon: Codicon.signIn,
+				menu: {
+					id: AccountMenu,
+					when: ContextKeyExpr.notEquals('defaultAccountStatus', 'available'),
+					group: '1_account',
+					order: 1,
+				}
+			});
+		}
+		async run(accessor: ServicesAccessor): Promise<void> {
+			await accessor.get(ICommandService).executeCommand(CHAT_SETUP_ACTION_ID);
+		}
+	});
+}
 
