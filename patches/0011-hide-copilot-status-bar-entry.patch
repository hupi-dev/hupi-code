+
+// HUPI Code patch: diagnostic-only command for build/smoke-test.sh, same
+// idea as `_hupi.getContextKeyValue` above (patches/0007). The status bar
+// entry this patch removes has no command or context key an extension
+// could check, so the probe asks for the IDs of every workbench
+// contribution created so far (the registry's own `timings`, the data
+// behind "Developer: Startup Performance") and checks that
+// `workbench.contrib.chatStatusBarEntry` isn't among them.
+CommandsRegistry.registerCommand('_hupi.getWorkbenchContributionIds', () => {
+	const ids: string[] = [];
+	for (const timings of Registry.as<IWorkbenchContributionsRegistry>(WorkbenchExtensions.Workbench).timings.values()) {
+		for (const [id] of timings) {
+			ids.push(id);
+		}
+	}
+	return ids;
+});
