+// HUPI Code patch: every in-app way into the Agents window (the
+// separate `vs/sessions` window, a Copilot-first surface) is registered
+// here — the command palette's "Open Agents Window" / "Open in Agents",
+// Ctrl+Shift+A, the chat and title bar "Open in Agents" buttons, and,
+// indirectly, the Welcome page's "Try out the new Agents window" banner
+// (`canShowAgentsBanner` only shows it if
+// OPEN_WORKSPACE_IN_AGENTS_WINDOW_COMMAND_ID is registered). In a HUPI
+// Code build that window can never get past its own first-launch
+// loading overlay: `SessionsSetUpService` awaits
+// `IDefaultAccountService.getDefaultAccount()`, which waits on a barrier
+// only `setDefaultAccountProvider` opens — and patches/0009 skips that
+// on purpose. Without 0009 it would instead stop at a "Sign in to use
+// GitHub Copilot" dialog. Neither is something a HUPI-native IDE should
+// advertise, so none of these entry points are registered.
+if (!product.hupiDisableAgentsWindow) {
+	registerAction2(OpenWorkspaceInAgentsWindowAction);
+	registerAction2(OpenWorkspaceInAgentsWindowChatTitleAction);
+	registerAction2(OpenWorkspaceInAgentsWindowTitleBarAction);
+	registerAction2(ToggleOpenInAgentsWindowTitleBarAction);
+	registerAction2(OpenAgentsWindowAction);
+	registerAction2(OpenChatSessionInAgentsWindowAction);
+}
