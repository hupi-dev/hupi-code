<?xml version="1.0" encoding="utf-8"?>
<!--
  Template, not a real manifest — @@IDENTITY_NAME@@ and @@PUBLISHER@@ are
  filled in by build/package-msix.sh, which now defaults them to the
  real values from "HUPI Code"'s Microsoft Partner Center reservation
  (partner.microsoft.com) — public identifiers, not secrets, so they're
  fine to default in a committed script; MSIX_IDENTITY_NAME/
  MSIX_PUBLISHER env vars still override if the reservation ever
  changes. See docs/MICROSOFT_STORE.md for the full submission process
  this fits into.

  This uses the "Desktop Bridge" pattern (EntryPoint="Windows.
  FullTrustApplication" + the runFullTrust capability below) — the
  standard, Microsoft-documented way to package an existing, unmodified
  Win32 app for the Store without rewriting it as a UWP app. The
  packaged executable itself needs zero changes for this. Its real name
  is "HUPI Code.exe" (with a space) — @vscode/gulp-electron's win32.js
  renames the root .exe to `${productName}.exe`, and productName comes
  from product.nameShort ("HUPI Code"), not applicationName
  ("hupi-code") — confirmed by inspecting that package's actual source
  after a real build's smoke test failed looking for the wrong name.

  AppData write virtualization is kept, except for one folder: HUPI
  Code's own data folder, %APPDATA%\HUPI Code (Windows 11 flexible
  virtualization; it needs the unvirtualizedResources capability, from
  Windows 10 1903 — hence MinVersion 10.0.18362.0). With MSIX's default,
  a packaged app's writes there silently land in the package's private
  LocalCache\Roaming copy, and a separate program the app starts may not
  see them. Extensions do exactly that: write a file to their
  globalStorage folder (inside %APPDATA%\HUPI Code\User), then start a
  helper program with its path (seen in Store certification: Universal
  Chat Provider's CLIProxyAPI failed with "The system cannot find the
  path specified" for the config.yaml the extension had just written).
  Everything else under AppData, and all registry writes, stay
  virtualized. Windows 10 ignores the exclusion and virtualizes as before.
  See docs/MICROSOFT_STORE.md for the capability justification.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:virtualization="http://schemas.microsoft.com/appx/manifest/virtualization/windows10"
  IgnorableNamespaces="uap rescap virtualization">

  <Identity
    Name="@@IDENTITY_NAME@@"
    Publisher="@@PUBLISHER@@"
    Version="@@VERSION@@" />

  <Properties>
    <DisplayName>HUPI Code</DisplayName>
    <PublisherDisplayName>HUPI Code</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <virtualization:FileSystemWriteVirtualization>
      <virtualization:ExcludedDirectories>
        <virtualization:ExcludedDirectory>$(KnownFolder:RoamingAppData)\HUPI Code</virtualization:ExcludedDirectory>
      </virtualization:ExcludedDirectories>
    </virtualization:FileSystemWriteVirtualization>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.18362.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="HUPICode" Executable="HUPI Code.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="HUPI Code"
        Description="A HUPI-native fork of VS Code — chat, inline edit, completions, and multi-file review, backed by your own HUPI memory gateway instead of a vendor."
        BackgroundColor="#0b0e19"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile
          Wide310x150Logo="Assets\Wide310x150Logo.png"
          Square310x310Logo="Assets\Square310x310Logo.png"
          Square71x71Logo="Assets\Square71x71Logo.png">
          <uap:ShowNameOnTiles>
            <uap:ShowOn Tile="square150x150Logo" />
            <uap:ShowOn Tile="wide310x150Logo" />
          </uap:ShowNameOnTiles>
        </uap:DefaultTile>
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>
</Package>
